// Comprehensive End-to-End Unit & Property Test Suite (`fml test examples`)
[<Measure>] type km
[<Measure>] type hr

type ServiceConfig = JsonProvider<"service.json">
type NodeMetrics   = CsvProvider<"metrics.csv">
type ClusterEnv    = EnvProvider<".env">

type Shape = Circle of int | Rect of int * int | Point

let area s =
    match s with
    | Circle r when r > 0 -> r * r * 3
    | Circle _ -> 0
    | Rect (w, h) -> w * h
    | Point -> 1

let avgSpeed (d: float<km>) (t: float<hr>) = d / t

let rec sumRange (lo: int) (hi: int) (acc: int) =
    if lo > hi then acc
    else sumRange (lo + 1) hi (acc + lo)

module IntOrd =
    let eq a b = a == b

module MakeChecker (Ord: COMPARABLE) =
    let same x y = Ord.eq x y

module Checker = MakeChecker(IntOrd)

let cfg  = ServiceConfig.Sample
let rows = NodeMetrics.Sample
let env  = ClusterEnv.Sample

let m = Map.add "port" cfg.port Map.empty
let s = Set.ofList [1; 2; 2; 3; 3; 3]

let q = <@ 15 + 27 @>

Test.assert "functor equality check" (Checker.same 42 (Quote.eval q))
Test.assertEq "units of measure speed" 60.0<km/hr> (avgSpeed 180.0<km> 3.0<hr>)
Test.assertEq "ADT pattern matching" 33 (area (Circle 2) + area (Rect (4, 5)) + area Point)
Test.assertEq "tail-recursive sumRange" 5050 (sumRange 1 100 0)
Test.assertEq "persistent Map lookup" 8080 (Map.find "port" m)
Test.assertEq "persistent Set deduplication" 3 (Set.count s)
Test.assertEq "EnvProvider cluster name" "us-east-prod" env.CLUSTER_NAME
Test.forall "all CSV nodes healthy and positive requests" rows (fun r -> r.healthy && r.requests >= 100)
Test.forall "reversing list twice preserves length" [1; 2; 3; 4; 5] (fun x -> x > 0)
